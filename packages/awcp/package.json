{
  "name": "@agentworks/awcp",
  "version": "0.1.9",
  "description": "AgentWorks Compliance Protocol (AWCP) \u2014 canonical action schema, policy check API, audit log format, and rule pack manifest",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./action": {
      "import": "./dist/action.js",
      "types": "./dist/action.d.ts"
    },
    "./policy-check": {
      "import": "./dist/policy-check.js",
      "types": "./dist/policy-check.d.ts"
    },
    "./audit-log": {
      "import": "./dist/audit-log.js",
      "types": "./dist/audit-log.d.ts"
    },
    "./rule-pack": {
      "import": "./dist/rule-pack.js",
      "types": "./dist/rule-pack.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentworks/shared": "workspace:*",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentworks",
    "awcp",
    "compliance",
    "tcpa",
    "rule-pack",
    "policy-engine"
  ],
  "license": "UNLICENSED",
  "private": true
}
