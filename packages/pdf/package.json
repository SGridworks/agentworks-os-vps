{
  "name": "@agentworks/pdf",
  "version": "0.1.9",
  "description": "AgentWorks PDF rendering: HTML-to-PDF engine for compliance evidence reports. Puppeteer-based with a fake engine for tests and dry-run mode.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fake": {
      "import": "./dist/fake-engine.js",
      "types": "./dist/fake-engine.d.ts"
    },
    "./puppeteer": {
      "import": "./dist/puppeteer-engine.js",
      "types": "./dist/puppeteer-engine.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "puppeteer-core": "^23.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
