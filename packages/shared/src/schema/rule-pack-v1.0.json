{
  "$ref": "#/definitions/RulePack",
  "definitions": {
    "RulePack": {
      "type": "object",
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pack_version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+((?:[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)))?$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^awcp\\/v\\d+\\.\\d+$"
        },
        "pack_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "pack_description": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "free",
            "paid",
            "attorney-reviewed"
          ],
          "default": "free"
        },
        "credentialed_by": {
          "type": "string"
        },
        "attorney_reviewed": {
          "type": "boolean",
          "default": false
        },
        "attorney_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "attorney_engagement_letter_on_file": {
          "type": "boolean",
          "default": false
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "industry": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "target_action_kinds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_data_disposition": {
          "type": "string",
          "enum": [
            "allow",
            "block",
            "route_to_review"
          ],
          "default": "route_to_review"
        },
        "required_data_declarations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "data_provider": {
                    "type": "string",
                    "enum": [
                      "substrate",
                      "customer_integration",
                      "external_api"
                    ]
                  }
                },
                "required": [
                  "field",
                  "description",
                  "data_provider"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required_data": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "disposition_when_missing": {
                "$ref": "#/definitions/RulePack/properties/missing_data_disposition",
                "default": "route_to_review"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "default": 100
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "when": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "then": {
                      "type": "object",
                      "properties": {
                        "decision": {
                          "$ref": "#/definitions/RulePack/properties/missing_data_disposition"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "citation": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "decision",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "when",
                    "then"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "rule_id",
              "name",
              "description",
              "required_data",
              "conditions"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "test_fixtures": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "expected": {
                    "type": "object",
                    "properties": {
                      "decision": {
                        "$ref": "#/definitions/RulePack/properties/missing_data_disposition"
                      },
                      "rule_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "decision"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "input",
                  "expected"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "changelog": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "version": {
                    "$ref": "#/definitions/RulePack/properties/pack_version"
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "changes": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "version",
                  "date",
                  "changes"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pack_id",
        "pack_version",
        "schema_version",
        "rules"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}