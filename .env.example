# AgentWorks OS source-install environment
#
# Copy to .env before running docker compose:
#   cp .env.example .env
#   openssl rand -hex 32

AGENTWORKS_SESSION_SECRET=replace-with-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Services bind to loopback by default so a VPS does not expose unauthenticated
# daemon/MCP endpoints to the internet. Use a reverse proxy, VPN, or SSH tunnel
# for remote access. Set these to 0.0.0.0 only behind TLS and auth.
AGENTOS_BIND_ADDR=127.0.0.1
SCANNER_BIND_ADDR=127.0.0.1
ADMIN_UI_BIND_ADDR=127.0.0.1

AGENTOS_HOST_PORT=7710
SCANNER_HOST_PORT=3101
ADMIN_UI_HOST_PORT=3000

AGENTWORKS_DATA_DIR=./data
AGENTWORKS_CONFIG_DIR=./config
AGENTWORKS_VERSION=0.1.9
